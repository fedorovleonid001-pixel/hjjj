function drawCreator(){
 el('race-title').textContent=races[selectedRace][0];
 el('race-desc').textContent=raceDescriptions[selectedRace];
 el('hero-preview').innerHTML=sprite(selectedRace,selectedGender);
 for(const button of el('gender-select').children)button.setAttribute('aria-pressed',String(button.dataset.gender===selectedGender));
 for(const button of el('avatars').children){
  const race=button.dataset.race;
  button.innerHTML=sprite(race,selectedGender)+'<strong>'+races[race][0]+'</strong>';
  button.setAttribute('aria-pressed',String(race===selectedRace));
 }
}
for(const race of Object.keys(races)){
 const card=document.createElement('button');card.type='button';card.dataset.race=race;
 card.onclick=()=>{selectedRace=race;drawCreator()};el('avatars').append(card);
}
for(const button of el('gender-select').children)button.onclick=()=>{selectedGender=button.dataset.gender;drawCreator()};
drawCreator();
el('login').onsubmit=e=>{
 e.preventDefault();act(token?'avatar':'join',{name:el('name').value,race:selectedRace,gender:selectedGender});
};
el('summon').onclick=()=>act('summon');
function meter(n,value){const m=document.querySelectorAll('.meter')[n];m.querySelector('i').style.width=value+'%';m.querySelector('span').textContent=value+'%'}
async function boot(){
 const delay=ms=>new Promise(resolve=>setTimeout(resolve,ms));
 meter(0,0);
 const art=el('splash-art');
 await Promise.all([art.decode().catch(()=>{}),delay(450)]);
 meter(0,70);
 if(token)await act('state');
 meter(0,100);
 await delay(650);el('loading').hidden=true;
}
boot();setInterval(()=>{if(token&&(!state?.battle||state.battle.done)&&!el('reward-dialog').open&&!el('victory-dialog').open&&!el('journal').open&&!el('gear').open)act('state')},5000);
</script></html>








